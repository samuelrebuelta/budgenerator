rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins are identified by the `admin` custom claim, assigned only with Admin SDK
    // (scripts/set-admin-claim.mjs). `accountData.isAdmin` is informative and never trusted.
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true;
    }
    // Private account content (budgets, projects, catalog, templates...) is owner-only.
    // Admins manage plans on the account root and do not read customers' documents.
    function canUse(uid) { return owner(uid); }
    function validLegalAcceptance(data) {
      return !('legalAcceptance' in data) || (
        data.legalAcceptance is map
        && data.legalAcceptance.keys().hasOnly(['version', 'acceptedAt'])
        && data.legalAcceptance.version is string
        && data.legalAcceptance.version.size() > 0 && data.legalAcceptance.version.size() <= 20
        && data.legalAcceptance.acceptedAt == request.time
      );
    }
    function optionalText(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }
    function validProfile(data) {
      return data.keys().hasOnly(['name', 'cif', 'address', 'phone', 'email', 'privacyPolicyUrl', 'logo'])
        && optionalText(data, 'name', 200) && optionalText(data, 'cif', 40)
        && optionalText(data, 'address', 400) && optionalText(data, 'phone', 40)
        && optionalText(data, 'email', 254)
        && (!('privacyPolicyUrl' in data) || data.privacyPolicyUrl == ''
          || (data.privacyPolicyUrl is string && data.privacyPolicyUrl.size() <= 500
            && data.privacyPolicyUrl.matches('^https://[^\\s]+$')))
        // Compressed client-side to ~400 px WebP/JPEG; keeps the document far from 1 MiB.
        && (!('logo' in data) || data.logo == ''
          || (data.logo is string && data.logo.size() <= 200000
            && data.logo.matches('^data:image/(webp|jpeg|png);base64,.*')));
    }
    function validAccount(a) {
      return a.keys().hasOnly(['isAdmin', 'plan', 'premiumExpiresAt', 'premiumExpiresAtMillis'])
        && a.isAdmin is bool && a.plan in ['free', 'premium']
        && (a.get('premiumExpiresAtMillis', null) == null || a.premiumExpiresAtMillis is int);
    }
    function premium(a) {
      return a.plan == 'premium' && (
        a.get('premiumExpiresAt', null) == null
        || (a.get('premiumExpiresAtMillis', 0) is int && a.get('premiumExpiresAtMillis', 0) > request.time.toMillis())
      );
    }
    function validCreationCount(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let id = after.get('lastCreatedBudgetId', '');
      return after.diff(before).affectedKeys().hasOnly(['totalBudgetsCreated', 'lastCreatedBudgetId'])
        && after.totalBudgetsCreated == before.totalBudgetsCreated + 1
        && (premium(before.accountData) || before.totalBudgetsCreated < 3)
        && id is string && id.size() > 0
        && !exists(/databases/$(database)/documents/users/$(uid)/budgets/$(id))
        && getAfter(/databases/$(database)/documents/users/$(uid)/budgets/$(id)).data.id == id;
    }
    // ── Canonical FIEBDC documents (budgets, templates, catalog) ──
    // Root: light metadata + business fields; content/{0..7}: FIEBDC JSON chunks of one revision.
    function validAdjustment(d) {
      return !('adjustment' in d) || (
        d.adjustment is map && d.adjustment.keys().hasOnly(['multiplier', 'reason'])
        && d.adjustment.multiplier is number
        && d.adjustment.multiplier >= 0 && d.adjustment.multiplier <= 11
        && d.adjustment.reason is string && d.adjustment.reason.size() <= 300
      );
    }
    function validDocumentRoot(id, d, kind) {
      return d.keys().hasOnly([
          'id', 'kind', 'schemaVersion', 'revision', 'contentRevision', 'chunkCount',
          'createdAt', 'updatedAt', 'name', 'clientName', 'address', 'date', 'budgetNumber',
          'ivaRate', 'adjustment', 'number', 'acceptedAt', 'projectId', 'sourceLeadId'
        ])
        && d.id == id && d.kind == kind && d.schemaVersion == 1
        && d.revision is int && d.revision >= 1
        && d.contentRevision is int && d.contentRevision >= 1 && d.contentRevision <= d.revision
        && d.chunkCount is int && d.chunkCount >= 1 && d.chunkCount <= 8
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.updatedAt is string && d.updatedAt.size() <= 40
        && d.name is string && d.name.size() <= 200
        && d.clientName is string && d.clientName.size() <= 200
        && d.address is string && d.address.size() <= 300
        && d.date is string && d.date.size() <= 40
        && d.budgetNumber is string && d.budgetNumber.size() <= 40
        && d.ivaRate is number && d.ivaRate >= 0 && d.ivaRate <= 1
        && validAdjustment(d);
    }
    // Every root update bumps the revision by one (optimistic concurrency across devices).
    function validRootUpdate(uid, collection, id, kind) {
      let before = resource.data;
      let after = request.resource.data;
      return validDocumentRoot(id, after, kind)
        && after.revision == before.revision + 1
        && after.createdAt == before.createdAt
        && (after.contentRevision == before.contentRevision
          || (after.contentRevision == after.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/$(collection)/$(id)/content/0).data.revision == after.revision));
    }
    function validChunk(index, rootPath) {
      let root = getAfter(rootPath).data;
      let data = request.resource.data;
      return data.keys().hasOnly(['index', 'revision', 'data'])
        && index.matches('^[0-7]$') && data.index == int(index)
        && data.index < root.chunkCount
        && data.revision == root.contentRevision
        && data.data is string && data.data.size() <= 1000000
        && (exists(rootPath)
          ? root.revision == get(rootPath).data.revision + 1
          : root.revision == 1);
    }
    function validChunkDelete(index, rootPath) {
      return !existsAfter(rootPath)
        || (int(index) >= getAfter(rootPath).data.chunkCount
          && getAfter(rootPath).data.revision == get(rootPath).data.revision + 1);
    }
    function validProjectLink(uid, id) {
      let projectId = request.resource.data.get('projectId', '');
      let projectAfter = getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(projectId)).data;
      return projectId is string && projectId.size() > 0
        && projectAfter.sourceBudgetId == id;
    }
    function validProjectCreate(uid, projectId) {
      let budgetId = request.resource.data.get('sourceBudgetId', '');
      let budgetRef = /databases/$(database)/documents/users/$(uid)/budgets/$(budgetId);
      let sourceBefore = get(budgetRef).data;
      let sourceAfter = getAfter(budgetRef).data;
      return request.resource.data.id == projectId
        && budgetId is string && budgetId.size() > 0
        && sourceBefore.get('acceptedAt', null) is string
        && sourceBefore.get('projectId', null) == null
        && sourceAfter.get('projectId', null) == projectId;
    }
    function validProjectName(value) {
      return value is string && value.size() > 0 && value.size() <= 120
        && value.matches('.*\\S.*');
    }
    function validProjectClientName(value) {
      return value is string && value.size() <= 120
        && (value.size() == 0 || value.matches('.*\\S.*'));
    }
    function validLinkedProjectMetadataUpdate(uid, projectId) {
      let project = request.resource.data;
      let changed = project.diff(resource.data).affectedKeys();
      let budgetId = resource.data.get('sourceBudgetId', '');
      let budgetPath = /databases/$(database)/documents/users/$(uid)/budgets/$(budgetId);
      let budget = getAfter(budgetPath).data;
      return changed.hasOnly(['title', 'clientName', 'address'])
        && validProjectName(project.title)
        && validProjectClientName(project.clientName)
        && project.address == project.title
        && budgetId is string && budgetId.size() > 0
        && existsAfter(budgetPath)
        && budget.id == budgetId && budget.projectId == projectId
        && budget.get('acceptedAt', null) is string
        && budget.address == project.title
        && budget.clientName == project.clientName;
    }
    function validLinkedBudgetMetadataUpdate(uid, budgetId) {
      let budget = request.resource.data;
      let changed = budget.diff(resource.data).affectedKeys();
      let projectId = resource.data.get('projectId', '');
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      let project = getAfter(projectPath).data;
      return changed.hasOnly(['address', 'clientName', 'revision', 'updatedAt'])
        && validProjectName(budget.address)
        && validProjectClientName(budget.clientName)
        && projectId is string && projectId.size() > 0
        && existsAfter(projectPath)
        && project.id == projectId && project.sourceBudgetId == budgetId
        && project.title == budget.address && project.address == budget.address
        && project.clientName == budget.clientName;
    }
    function validWorkforceMember(memberId, data) {
      return data.keys().hasOnly(['id', 'name', 'status', 'createdAt', 'updatedAt'])
        && data.id == memberId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.name.matches('.*\\S.*')
        && data.status in ['active', 'inactive']
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40;
    }
    function validWorkforceCrew(crewId, data) {
      return data.keys().hasOnly(['id', 'label', 'color', 'memberIds', 'status', 'createdAt', 'updatedAt'])
        && data.id == crewId
        && data.label is string && data.label.size() > 0 && data.label.size() <= 60
        && data.label.matches('.*\\S.*')
        && data.color in ['blue', 'green', 'amber', 'rose', 'violet', 'cyan', 'slate']
        && data.memberIds is list && data.memberIds.size() > 0
        && data.status in ['active', 'inactive']
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40;
    }
    function validAssignmentMember(data) {
      return data is map
        && data.keys().hasOnly(['id', 'name'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.name.matches('.*\\S.*');
    }
    function validProjectAssignmentSource(uid, data) {
      let memberPath = /databases/$(database)/documents/users/$(uid)/teamMembers/$(data.resourceId);
      let crewPath = /databases/$(database)/documents/users/$(uid)/crews/$(data.resourceId);
      let firstMemberPath = /databases/$(database)/documents/users/$(uid)/teamMembers/$(data.members[0].id);
      let member = get(memberPath).data;
      let crew = get(crewPath).data;
      let firstMember = get(firstMemberPath).data;
      return data.resourceType == 'member'
          ? exists(memberPath) && member.status == 'active'
            && data.label == member.name
            && data.members[0].id == data.resourceId
            && data.members[0].name == member.name
          : exists(crewPath) && crew.status == 'active'
            && data.label == crew.label && data.color == crew.color
            && crew.memberIds.hasAny([data.members[0].id])
            && exists(firstMemberPath) && firstMember.status == 'active'
            && data.members[0].name == firstMember.name;
    }
    function validProjectAssignment(uid, assignmentId, data) {
      let member = data.members[0];
      return data.keys().hasOnly([
          'id', 'resourceType', 'resourceId', 'label', 'color', 'members', 'assignedAt'
        ])
        && data.id == assignmentId
        && data.resourceType in ['member', 'crew']
        && data.resourceId is string && data.resourceId.size() > 0 && data.resourceId.size() <= 128
        && assignmentId == data.resourceType + '_' + data.resourceId
        && data.label is string && data.label.size() > 0 && data.label.size() <= 100
        && data.label.matches('.*\\S.*')
        && data.members is list && data.members.size() > 0 && data.members.size() <= 500
        && validAssignmentMember(member)
        && validProjectAssignmentSource(uid, data)
        && data.assignedAt is string && data.assignedAt.size() > 0 && data.assignedAt.size() <= 40
        && (data.resourceType == 'member'
          ? data.members.size() == 1 && member.id == data.resourceId && data.get('color', null) == null
          : data.color in ['blue', 'green', 'amber', 'rose', 'violet', 'cyan', 'slate']);
    }
    function validProjectDailyAssignment(uid, projectId, dateKey, data) {
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      let project = get(projectPath).data;
      return data.keys().hasOnly(['date', 'projectId', 'assignments', 'updatedAt'])
        && data.date == dateKey
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.projectId == projectId
        && data.assignments is list && data.assignments.size() <= 500
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40
        && project.status in ['pending', 'in_progress'];
    }
    function validAssignmentStateTransition(uid, projectId) {
      let statePath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/assignmentState/current;
      let previousRevision = exists(statePath) ? get(statePath).data.revision : 0;
      let nextState = getAfter(statePath).data;
      return nextState.keys().hasOnly(['revision'])
        && nextState.revision is int
        && nextState.revision == previousRevision + 1;
    }
    function validTeamJobProjectLink(uid, data) {
      let projectId = data.projectId;
      return projectId is string && projectId.size() > 0 && projectId.size() <= 128
        && !projectId.matches('.*[/].*')
        && validTeamJobProject(uid, projectId, data.projectTitle);
    }
    function validTeamJobProject(uid, projectId, projectTitle) {
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      return exists(projectPath)
        && get(projectPath).data.id == projectId
        && get(projectPath).data.title is string
        && get(projectPath).data.title.size() > 0
        && get(projectPath).data.title.size() <= 120
        && projectTitle == get(projectPath).data.title
        && get(projectPath).data.status in ['pending', 'in_progress', 'completed'];
    }
    function validTeamJob(uid, jobId, data) {
      return data.keys().hasOnly([
          'id', 'title', 'description', 'date', 'projectId', 'projectTitle', 'createdAt', 'updatedAt'
        ])
        && data.id == jobId
        && jobId is string && jobId.size() > 0 && jobId.size() <= 128 && !jobId.matches('.*[/].*')
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.title.matches('.*\\S.*')
        && data.description is string && data.description.size() <= 2000
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40
        && ('projectId' in data
          ? validTeamJobProjectLink(uid, data)
          : !('projectTitle' in data));
    }
    function teamJobExists(uid, jobId) {
      return exists(/databases/$(database)/documents/users/$(uid)/teamJobs/$(jobId));
    }
    function teamJobExistsAfter(uid, jobId) {
      return existsAfter(/databases/$(database)/documents/users/$(uid)/teamJobs/$(jobId));
    }
    function closeEnough(actual, expected) {
      return actual is number && actual >= expected - 0.01 && actual <= expected + 0.01;
    }
    function projectProgressStatus(completed, total) {
      return completed == 0 || total == 0 ? 'pending'
        : completed == total ? 'completed' : 'in_progress';
    }
    function validProjectSupplementUpdate(uid, projectId, supplementId) {
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      let before = get(projectPath).data;
      let after = getAfter(projectPath).data;
      let supplement = getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplements/$(supplementId)).data;
      let supplementPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplements/$(supplementId);
      let totalConcepts = before.totalConcepts + 1;
      let totalAmount = before.totalAmount + supplement.subtotal;
      let completedConcepts = before.completedConcepts;
      let changed = after.diff(before).affectedKeys();
      return supplement.id == supplementId
        && !exists(supplementPath)
        && after.get('lastSupplementId', '') == supplementId
        && after.get('lastSupplementAction', '') == 'added'
        && changed.hasOnly([
          'supplementsSubtotal', 'supplementsIva', 'updatedTotal', 'workItemCount',
          'totalConcepts', 'completedConcepts', 'totalAmount', 'completedAmount',
          'percent', 'status', 'completedAt', 'lastSupplementId', 'lastSupplementAction'
        ])
        && closeEnough(after.get('supplementsSubtotal', 0), before.get('supplementsSubtotal', 0) + supplement.subtotal)
        && closeEnough(after.get('supplementsIva', 0), before.get('supplementsIva', 0) + supplement.iva)
        && closeEnough(after.get('updatedTotal', before.total), before.get('updatedTotal', before.total) + supplement.total)
        && after.workItemCount == before.workItemCount + 1
        && after.totalConcepts == totalConcepts
        && after.completedConcepts == completedConcepts
        && closeEnough(after.totalAmount, totalAmount)
        && closeEnough(after.completedAmount, before.completedAmount)
        && after.status == projectProgressStatus(completedConcepts, totalConcepts)
        && after.percent is int && after.percent >= 0 && after.percent < 100
        && after.get('completedAt', null) == null;
    }
    function progressCompleted(uid, projectId, supplementId) {
      let statePath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/progress/state;
      return exists(statePath)
        && get(statePath).data.completed.get('concept_' + supplementId, null) is string;
    }
    function validSupplementVoidLink(uid, projectId, supplementId) {
      let supplementPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplements/$(supplementId);
      let voidPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplementVoids/$(supplementId);
      let voidAfter = getAfter(voidPath).data;
      return exists(supplementPath) && !exists(voidPath)
        && voidAfter.supplementId == supplementId
        && voidAfter.reason is string && voidAfter.reason.size() > 0 && voidAfter.reason.size() <= 500
        && voidAfter.voidedAt is string;
    }
    function validVoidProjectProgress(uid, projectId, supplementId) {
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      let before = get(projectPath).data;
      let after = getAfter(projectPath).data;
      let completed = progressCompleted(uid, projectId, supplementId);
      let totalConcepts = before.totalConcepts - 1;
      let completedConcepts = before.completedConcepts - (completed ? 1 : 0);
      let changed = after.diff(before).affectedKeys();
      return after.get('lastSupplementId', '') == supplementId
        && after.get('lastSupplementAction', '') == 'voided'
        && changed.hasOnly([
          'supplementsSubtotal', 'supplementsIva', 'updatedTotal', 'workItemCount',
          'totalConcepts', 'completedConcepts', 'totalAmount', 'completedAmount',
          'percent', 'status', 'completedAt', 'lastSupplementId', 'lastSupplementAction'
        ])
        && after.workItemCount == before.workItemCount - 1
        && after.totalConcepts == totalConcepts
        && after.completedConcepts == completedConcepts
        && after.status == projectProgressStatus(completedConcepts, totalConcepts)
        && after.percent is int
        && (after.status == 'completed'
          ? after.percent == 100 && after.get('completedAt', null) is string
          : after.percent >= 0 && after.percent < 100 && after.get('completedAt', null) == null);
    }
    function validVoidProjectAmounts(uid, projectId, supplementId) {
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      let supplementPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplements/$(supplementId);
      let before = get(projectPath).data;
      let after = getAfter(projectPath).data;
      let supplement = get(supplementPath).data;
      let completed = progressCompleted(uid, projectId, supplementId);
      return closeEnough(after.get('supplementsSubtotal', 0), before.get('supplementsSubtotal', 0) - supplement.subtotal)
        && closeEnough(after.get('supplementsIva', 0), before.get('supplementsIva', 0) - supplement.iva)
        && closeEnough(after.get('updatedTotal', before.total), before.get('updatedTotal', before.total) - supplement.total)
        && closeEnough(after.totalAmount, before.totalAmount - supplement.subtotal)
        && closeEnough(after.completedAmount, before.completedAmount - (completed ? supplement.subtotal : 0));
    }
    function validProjectSupplementVoidUpdate(uid, projectId, supplementId) {
      return validSupplementVoidLink(uid, projectId, supplementId)
        && validVoidProjectProgress(uid, projectId, supplementId)
        && validVoidProjectAmounts(uid, projectId, supplementId);
    }
    function validSupplementCreate(uid, projectId, supplementId) {
      let projectPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId);
      let supplementPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplements/$(supplementId);
      let projectBefore = get(projectPath).data;
      let data = getAfter(supplementPath).data;
      return data.keys().hasOnly([
          'id', 'description', 'quantity', 'unit', 'unitPrice', 'vatRate',
          'subtotal', 'iva', 'total', 'createdAt', 'workItemId'
        ])
        && data.id == supplementId && supplementId.matches('^[A-Za-z0-9_-]{1,100}$')
        && data.description is string && data.description.size() > 0 && data.description.size() <= 300
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 20
        && data.unitPrice is number && data.unitPrice > 0 && data.unitPrice <= 1000000
        && data.vatRate == projectBefore.ivaRate
        && data.subtotal is number && closeEnough(data.subtotal, data.quantity * data.unitPrice)
        && data.iva is number && closeEnough(data.iva, data.subtotal * data.vatRate)
        && data.total is number && closeEnough(data.total, data.subtotal + data.iva)
        && data.createdAt is string && data.workItemId == 'supplement_' + supplementId
        && !exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplementVoids/$(supplementId))
        && validProjectSupplementUpdate(uid, projectId, supplementId);
    }
    function validSupplementVoidCreate(uid, projectId, supplementId) {
      let supplementPath = /databases/$(database)/documents/users/$(uid)/projects/$(projectId)/supplements/$(supplementId);
      return request.resource.data.keys().hasOnly(['supplementId', 'reason', 'voidedAt'])
        && request.resource.data.supplementId == supplementId
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.voidedAt is string
        && exists(supplementPath)
        && validProjectSupplementVoidUpdate(uid, projectId, supplementId);
    }
    function validProgressState(data) {
      return data.keys().hasOnly(['completed', 'updatedAt'])
        && data.completed is map && data.completed.size() <= 10000
        && data.updatedAt is string && data.updatedAt.size() <= 40;
    }
    function validBudgetUpdate(uid, id) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let oldAccepted = before.get('acceptedAt', null);
      let newAccepted = after.get('acceptedAt', null);
      let oldProject = before.get('projectId', null);
      let newProject = after.get('projectId', null);
      let editable = oldAccepted == null && newAccepted == null && oldProject == null && newProject == null;
      let acceptanceChange = changed.hasOnly(['acceptedAt', 'revision', 'updatedAt'])
        && oldProject == null && newProject == null
        && (oldAccepted == null ? newAccepted is string : newAccepted == null);
      let conversion = changed.hasOnly(['projectId', 'revision', 'updatedAt'])
        && oldAccepted is string && oldProject == null
        && validProjectLink(uid, id);
      let linkedMetadata = oldAccepted is string && newAccepted == oldAccepted
        && oldProject is string && newProject == oldProject
        && validLinkedBudgetMetadataUpdate(uid, id);
      return canUse(uid) && validRootUpdate(uid, 'budgets', id, 'budget')
        && after.number == before.number
        && after.get('sourceLeadId', null) == before.get('sourceLeadId', null)
        && (editable || acceptanceChange || conversion || linkedMetadata);
    }
    match /users/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'accountData', 'totalBudgetsCreated', 'createdAt', 'budgetSlotsReleased', 'legalAcceptance'])
        && validLegalAcceptance(request.resource.data)
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.totalBudgetsCreated == 0
        && request.resource.data.get('budgetSlotsReleased', 0) == 0
        && request.resource.data.createdAt is string
        && request.resource.data.accountData == {'isAdmin': false, 'plan': 'free'};
      allow update: if (owner(uid) && validCreationCount(uid)) || (
        isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountData'])
        && validAccount(request.resource.data.accountData)
        && request.resource.data.accountData.isAdmin == resource.data.accountData.isAdmin
      );
      allow delete: if false;
      match /budgets/{id} {
        allow read: if canUse(uid);
        allow delete: if canUse(uid)
          && resource.data.get('acceptedAt', null) == null
          && resource.data.get('projectId', null) == null;
        // Creation consumes one quota slot and takes the next number from the account counter.
        allow create: if owner(uid)
          && validDocumentRoot(id, request.resource.data, 'budget')
          && request.resource.data.revision == 1 && request.resource.data.contentRevision == 1
          && request.resource.data.number is int
          && request.resource.data.number == getAfter(/databases/$(database)/documents/users/$(uid)).data.totalBudgetsCreated
          && request.resource.data.get('acceptedAt', null) == null
          && request.resource.data.get('projectId', null) == null
          && (request.resource.data.get('sourceLeadId', null) == null
            || (request.resource.data.sourceLeadId is string && request.resource.data.sourceLeadId.size() <= 128))
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.lastCreatedBudgetId == id
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.totalBudgetsCreated == get(/databases/$(database)/documents/users/$(uid)).data.totalBudgetsCreated + 1;
        allow update: if validBudgetUpdate(uid, id);
        match /content/{index} {
          allow read: if canUse(uid);
          // Content is frozen once the budget is accepted or converted.
          allow create, update: if owner(uid)
            && validChunk(index, /databases/$(database)/documents/users/$(uid)/budgets/$(id))
            && getAfter(/databases/$(database)/documents/users/$(uid)/budgets/$(id)).data.get('acceptedAt', null) == null
            && getAfter(/databases/$(database)/documents/users/$(uid)/budgets/$(id)).data.get('projectId', null) == null;
          allow delete: if owner(uid)
            && validChunkDelete(index, /databases/$(database)/documents/users/$(uid)/budgets/$(id));
        }
      }
      match /templates/{id} {
        allow read: if canUse(uid);
        allow create: if owner(uid)
          && validDocumentRoot(id, request.resource.data, 'template')
          && request.resource.data.revision == 1 && request.resource.data.contentRevision == 1
          && !('number' in request.resource.data) && !('acceptedAt' in request.resource.data)
          && !('projectId' in request.resource.data) && !('sourceLeadId' in request.resource.data);
        allow update: if owner(uid) && validRootUpdate(uid, 'templates', id, 'template')
          && !('number' in request.resource.data) && !('acceptedAt' in request.resource.data)
          && !('projectId' in request.resource.data) && !('sourceLeadId' in request.resource.data);
        allow delete: if owner(uid);
        match /content/{index} {
          allow read: if canUse(uid);
          allow create, update: if owner(uid)
            && validChunk(index, /databases/$(database)/documents/users/$(uid)/templates/$(id));
          allow delete: if owner(uid)
            && validChunkDelete(index, /databases/$(database)/documents/users/$(uid)/templates/$(id));
        }
      }
      // Single catalog per account.
      match /catalog/{docId} {
        allow read: if canUse(uid);
        allow create: if owner(uid) && docId == 'main'
          && validDocumentRoot(docId, request.resource.data, 'catalog')
          && request.resource.data.revision == 1 && request.resource.data.contentRevision == 1
          && !('number' in request.resource.data) && !('acceptedAt' in request.resource.data)
          && !('projectId' in request.resource.data) && !('sourceLeadId' in request.resource.data);
        allow update: if owner(uid) && docId == 'main' && validRootUpdate(uid, 'catalog', docId, 'catalog')
          && !('number' in request.resource.data) && !('acceptedAt' in request.resource.data)
          && !('projectId' in request.resource.data) && !('sourceLeadId' in request.resource.data);
        allow delete: if false;
        match /content/{index} {
          allow read: if canUse(uid);
          allow create, update: if owner(uid) && docId == 'main'
            && validChunk(index, /databases/$(database)/documents/users/$(uid)/catalog/$(docId));
          allow delete: if owner(uid)
            && validChunkDelete(index, /databases/$(database)/documents/users/$(uid)/catalog/$(docId));
        }
      }
      match /projects/{projectId} {
        allow read: if canUse(uid);
        allow create: if owner(uid) && validProjectCreate(uid, projectId);
        allow update: if canUse(uid)
          && request.resource.data.id == projectId
          && request.resource.data.sourceBudgetId == resource.data.sourceBudgetId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'completedConcepts', 'completedAmount', 'percent', 'status', 'completedAt'
            ])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estimatedEndDate'])
              && request.resource.data.estimatedEndDate is string
              && request.resource.data.estimatedEndDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            || validLinkedProjectMetadataUpdate(uid, projectId)
            || (request.resource.data.get('lastSupplementAction', '') == 'added'
              && validProjectSupplementUpdate(uid, projectId, request.resource.data.get('lastSupplementId', '')))
            || (request.resource.data.get('lastSupplementAction', '') == 'voided'
              && validProjectSupplementVoidUpdate(uid, projectId, request.resource.data.get('lastSupplementId', '')))
          );
        allow delete: if false;
        match /supplements/{supplementId} {
          allow read: if canUse(uid);
          allow create: if owner(uid) && validSupplementCreate(uid, projectId, supplementId);
          allow update, delete: if false;
        }
        match /supplementVoids/{supplementId} {
          allow read: if canUse(uid);
          allow create: if owner(uid) && validSupplementVoidCreate(uid, projectId, supplementId);
          allow update, delete: if false;
        }
        // Completion date per item occurrence (node ID) or supplement task.
        match /progress/{stateId} {
          allow read: if canUse(uid);
          allow create: if owner(uid) && stateId == 'state'
            && validProgressState(request.resource.data)
            && (exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId))
              || getAfter(/databases/$(database)/documents/users/$(uid)/projects/$(projectId)).data.id == projectId);
          allow update: if owner(uid) && stateId == 'state'
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId))
            && validProgressState(request.resource.data);
          allow delete: if false;
        }
        match /assignments/{assignmentId} {
          allow read: if owner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId));
          allow create: if owner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId))
            && validProjectAssignment(uid, assignmentId, request.resource.data)
            && validAssignmentStateTransition(uid, projectId);
          allow update: if false;
          allow delete: if owner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId))
            && validAssignmentStateTransition(uid, projectId);
        }
        match /dailyAssignments/{dateKey} {
          allow read: if owner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId));
          allow create, update: if owner(uid)
            && validProjectDailyAssignment(uid, projectId, dateKey, request.resource.data);
          allow delete: if owner(uid)
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId));
        }
        match /assignmentState/{stateId} {
          allow read: if owner(uid) && stateId == 'current'
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId));
          allow create: if owner(uid) && stateId == 'current'
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId))
            && request.resource.data.keys().hasOnly(['revision'])
            && request.resource.data.revision is int
            && request.resource.data.revision == 1;
          allow update: if owner(uid) && stateId == 'current'
            && exists(/databases/$(database)/documents/users/$(uid)/projects/$(projectId))
            && resource.data.keys().hasOnly(['revision'])
            && resource.data.revision is int
            && request.resource.data.keys().hasOnly(['revision'])
            && request.resource.data.revision is int
            && request.resource.data.revision == resource.data.revision + 1;
          allow delete: if false;
        }
      }
      match /teamMembers/{memberId} {
        allow read: if canUse(uid);
        allow create: if owner(uid) && validWorkforceMember(memberId, request.resource.data);
        allow update: if owner(uid)
          && validWorkforceMember(memberId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'status', 'updatedAt']);
        allow delete: if false;
      }
      match /crews/{crewId} {
        allow read: if canUse(uid);
        allow create: if owner(uid) && validWorkforceCrew(crewId, request.resource.data);
        allow update: if owner(uid)
          && validWorkforceCrew(crewId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'label', 'color', 'memberIds', 'status', 'updatedAt'
          ]);
        allow delete: if false;
      }
      match /teamJobs/{jobId} {
        allow read: if owner(uid);
        allow create: if owner(uid) && validTeamJob(uid, jobId, request.resource.data);
        allow update, delete: if false;
        match /assignments/{assignmentId} {
          allow read: if owner(uid) && teamJobExists(uid, jobId);
          allow create: if owner(uid)
            && teamJobExistsAfter(uid, jobId)
            && validProjectAssignment(uid, assignmentId, request.resource.data);
          allow update, delete: if false;
        }
      }
      match /quoteEstimator/{documentId} {
        allow get: if owner(uid) && documentId == 'settings';
        allow list: if false;
        // Saving the settings prepares a public page: require a verified email.
        allow create, update: if owner(uid) && documentId == 'settings' && verifiedEmail();
        allow delete: if owner(uid) && documentId == 'settings';
      }
      match /profile/{documentId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && documentId == 'data'
          && validProfile(request.resource.data);
        allow delete: if owner(uid);
      }
      match /leads/{leadId} {
        allow get, list: if owner(uid);
        allow create: if false;
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['budgetId'])
          && request.resource.data.budgetId is string
          && request.resource.data.budgetId.size() > 0
          && existsAfter(/databases/$(database)/documents/users/$(uid)/budgets/$(request.resource.data.budgetId));
        allow delete: if owner(uid);
      }
      match /{collectionName}/{documentId} {
        allow read: if canUse(uid) && collectionName == 'settings';
        allow write: if false;
      }
    }
    match /sharedBudgets/{token} {
      // v3: public FIEBDC content without costs, breakdowns or private extensions.
      allow get: if resource.data.schemaVersion == 3 && resource.data.expiresAt > request.time.toMillis();
      allow list: if false;
      allow create: if signedIn() && verifiedEmail()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'expiresAt', 'sharedAt', 'company', 'budget', 'content'])
        && request.resource.data.schemaVersion == 3 && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 2678400000
        && request.resource.data.sharedAt is string && request.resource.data.sharedAt.size() <= 40
        && request.resource.data.budget is map
        && request.resource.data.budget.keys().hasOnly(['id', 'clientName', 'address', 'date', 'budgetNumber', 'ivaRate', 'adjustment', 'createdAt'])
        && request.resource.data.budget.id is string && request.resource.data.budget.id.size() <= 128
        && request.resource.data.budget.ivaRate is number
        && validAdjustment(request.resource.data.budget)
        && request.resource.data.content is string && request.resource.data.content.size() <= 1000000
        && request.resource.data.company is map
        && request.resource.data.company.keys().hasOnly(['name', 'cif', 'address', 'phone', 'email', 'logo']);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.get('ownerUid', '') == request.auth.uid || isAdmin());
    }
    // Token ownership and per-token rate limits are server-only documents.
    match /publicQuoteTokens/{token} { allow read, write: if false; }
    match /quoteEstimatorLinks/{uid} { allow read, write: if false; }
    // Short links `/p/{slug}` and the owner → notice map are server-only (Functions).
    match /publicQuoteSlugs/{slug} { allow read, write: if false; }
    match /privacyNoticeOwners/{uid} { allow read, write: if false; }
    // Hosted privacy notices: public, one document at a time; written only by Functions.
    match /publicPrivacyNotices/{noticeId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /quoteEstimateRateLimits/{token} { allow read, write: if false; }
    match /quoteLeadRateLimits/{token} { allow read, write: if false; }
    // Anti-abuse counters (per network, owner and global); written only by Functions.
    match /abuseRateLimits/{key} { allow read, write: if false; }
  }
}
