# Copy to .env.local and fill with your Firebase web app configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public Web Push VAPID key; set only after Firebase Cloud Messaging is configured.
VITE_FIREBASE_VAPID_KEY=
# Only enable with a demo- project and local emulators.
VITE_USE_FIREBASE_EMULATORS=false
# App Check (reCAPTCHA Enterprise por defecto; "v3" para reCAPTCHA v3). Vacío = desactivado.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
# Solo para depurar App Check en local o staging; nunca en producción.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Región de Cloud Functions; debe coincidir con functions/src/core/config.ts.
VITE_FIREBASE_FUNCTIONS_REGION=europe-southwest1
