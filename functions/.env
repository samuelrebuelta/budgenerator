# Configuración no secreta de Cloud Functions. Se versiona a propósito.
# Para un proyecto concreto crea functions/.env.<projectId> (ignorado por Git).
# off | monitor | enforce. Empieza en monitor: registra peticiones sin App Check y las acepta.
APP_CHECK_MODE=monitor
# Retención de solicitudes (leads), en meses.
LEAD_RETENTION_MONTHS=12
# Limpieza de dispositivos push.
PUSH_DEVICE_INACTIVE_DAYS=270
PUSH_DEVICE_RECOVERY_DAYS=60
# Límites anti-abuso del estimador público y de las solicitudes.
LIMIT_ESTIMATOR_PER_IP_PER_MINUTE=60
LIMIT_ESTIMATOR_GLOBAL_PER_DAY=20000
LIMIT_LEADS_PER_IP_PER_HOUR=10
LIMIT_LEADS_PER_OWNER_PER_DAY=50
LIMIT_LEADS_GLOBAL_PER_DAY=500
LIMIT_LEAD_PUSH_PER_OWNER_PER_HOUR=5
