{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pnpm firebase:deploy:*)",
      "Bash(pnpm firebase:deploy)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase deploy:*)",
      "Bash(git push:*)",
      "Read(./docs/testing-access.local.md)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ],
    "ask": ["Bash(gh pr merge:*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-hooks/lint-changed.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
