{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./docs/testing-access.local.md)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.local)",
      "Read(./apps/mobile/firebase/preview/**)",
      "Read(./apps/mobile/firebase/production/**)"
    ],
    "ask": [
      "Bash(pnpm firebase:deploy*)",
      "Bash(node scripts/deploy.mjs*)",
      "Bash(firebase deploy *)",
      "Bash(pnpm exec firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agent-hooks/lint-changed.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks/allow-branch-push.mjs"
          }
        ]
      }
    ]
  }
}
