{
  "name": "budgenerator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build-icons.mjs && vite build && node scripts/build-sw.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "firebase:deploy": "node scripts/deploy.mjs hosting",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:e2e": "playwright test",
    "test:integration": "firebase emulators:exec --project demo-cimbra --only auth,firestore \"pnpm test:rules && pnpm test:e2e\"",
    "firebase:emulators": "firebase emulators:start --project demo-cimbra --only auth,firestore",
    "firebase:deploy:all": "node scripts/deploy.mjs firestore:rules,hosting",
    "format:check": "prettier --check src scripts tests *.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "clsx": "^2.1.1",
    "firebase": "^12.12.0",
    "i18next": "^26.0.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.15.0",
    "globals": "^17.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
